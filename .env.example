# Copia questo file in `.env` per la build locale.
# NON aggiungere `.env` a Git: è escluso da .gitignore.

# Chiave Gemini (facoltativa).
# Lasciala vuota per creare una build sicura senza la tua chiave:
# il gioco, le lezioni, le statistiche e l'OCR ML Kit restano offline.
# Con la chiave vuota l'app chiederà il valore dalle Impostazioni.
GEMINI_API_KEY=

# Esempio con una chiave reale (da usare solo in locale):
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Firma release (facoltativa).
# Se non imposti questi valori, Gradle produrrà una release non firmata.
# Anche `keystore.properties` e il file .jks restano esclusi dal versionamento.
# KEYSTORE_FILE=keystore/sudoku-cat-release.jks
# KEYSTORE_PASSWORD=
# KEYSTORE_KEY_ALIAS=
# KEYSTORE_KEY_PASSWORD=
